# ============================================================
#  Пример конфигурации. Рабочий .env на сервере создаёт
#  scripts/bootstrap-server.sh — он же генерирует секреты.
#  Реальный .env в git не попадает (см. .gitignore).
# ============================================================

# -- Домен и TLS ---------------------------------------------
DOMAIN=sky.example.com
# Сюда Let's Encrypt пришлёт предупреждение, если сертификат не продлится.
CERTBOT_EMAIL=admin@example.com
# 1 — выпускать на тестовом сервере Let's Encrypt (сертификат невалидный,
# но не расходуются лимиты: 5 выпусков в неделю на домен).
CERTBOT_STAGING=0

# -- Секреты -------------------------------------------------
# Сгенерировать: openssl rand -base64 48
# Менять только вместе — смена разлогинит всех пользователей.
# JWT_SECRET к тому же участвует в шифровании секретов двухэтапной
# защиты, если не задан отдельный ENCRYPTION_KEY (см. ниже).
JWT_SECRET=замените_меня
REFRESH_TOKEN_SECRET=замените_меня_тоже

# Пароли БД и кэша. Задаются один раз при первом запуске:
# после инициализации тома смена пароля здесь ничего не изменит.
POSTGRES_PASSWORD=замените_меня
REDIS_PASSWORD=замените_меня

# -- Ключ шифрования -----------------------------------------
# Шифрует секреты двухэтапной защиты в базе: с ним дамп БД сам по себе
# не даёт возможности подделывать коды.
# Сгенерировать: openssl rand -base64 32
# Если оставить пустым, ключ выводится из JWT_SECRET — работать будет,
# но тогда смена JWT_SECRET сломает уже включённую защиту.
ENCRYPTION_KEY=

# -- Отправка кодов ------------------------------------------
# Вход идёт по ПОЧТЕ: на неё приходит код при каждом входе. Без
# настроенной почты войти не сможет никто.
# Телефон необязателен и нужен для второго фактора (код в SMS).
#
# ВАЖНО: 'log' пишет код в журнал контейнера и НИКУДА НЕ ОТПРАВЛЯЕТ.
# В бою он запрещён — иначе любой, кто читает логи, войдёт под чужим
# аккаунтом. Если всё же нужен (например, пока не подключён провайдер),
# поставьте ALLOW_LOG_CODES=1 и понимайте, чем рискуете.
#
#   SMS_MODE=textbee  — TextBee: SMS уходят через ваш телефон с Android.
#                       Нужен ключ из личного кабинета в SMS_API_ID;
#                       SMS_DEVICE_ID — только если телефонов несколько.
#   SMS_MODE=smsru    — sms.ru, нужен SMS_API_ID
#   SMS_MODE=webhook  — любой другой провайдер: POST {to, text}
#                       на SMS_WEBHOOK_URL
SMS_MODE=log
SMS_API_ID=
# Имя отправителя — только для sms.ru и только если оно согласовано.
SMS_FROM=
# Только для TextBee: какой телефон-шлюз использовать.
SMS_DEVICE_ID=
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=

# Почта — основной вход. Без неё приложение бесполезно.
#
#   EMAIL_MODE=smtp    — обычный почтовый ящик (в том числе у хостинга)
#   EMAIL_MODE=resend  — сервис Resend, нужен RESEND_API_KEY
#   EMAIL_MODE=webhook — свой обработчик: POST {to, subject, text}
EMAIL_MODE=log
# Адрес, от имени которого уходят письма. Он назван в документах как
# единственный отправитель Sky — менять его нельзя, не поменяв их.
EMAIL_FROM=Sky <no-reply@skymessenger.online>
SMTP_HOST=
# 465 — сразу TLS (SMTP_SECURE=true), 587 — STARTTLS (SMTP_SECURE=false).
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_TOKEN=

# Разрешает режим 'log' в бою. По умолчанию пусто — и это правильно.
ALLOW_LOG_CODES=

# -- Закрытая бета -------------------------------------------
# Пока приложение не готово, вход на сайт закрыт ключом. Формат:
# «ключ:подпись» через запятую, подпись нужна только чтобы понимать,
# чей ключ отзывать.
#
#   BETA_KEYS=Ab3...xY:мой,Qw9...zT:команда
#
# Ключ сгенерировать:  openssl rand -base64 24 | tr -d '/+=' | head -c 24
# Убрать ключ — убрать из этой строки и перезапустить API: список
# в базе приводится в соответствие при каждом запуске.
# Закончить бету — оставить строку пустой, тогда сайт открыт всем.
BETA_KEYS=

# -- Платежи -------------------------------------------------
# 'demo' разрешает пополнять кошелёк без настоящего платежа — только
# для отладки. В продакшне оставьте disabled, пока не подключён
# платёжный провайдер: иначе любой пользователь нарисует себе баланс.
PAYMENTS_MODE=disabled

# -- Поведение API -------------------------------------------
# Запросов в минуту с одного адреса на уровне приложения.
# Отдельные, более жёсткие лимиты на отправку и проверку кода
# стоят в nginx (5 и 20 запросов в минуту соответственно).
RATE_LIMIT_PER_MINUTE=120
# Время жизни access-токена, секунды (15 минут).
ACCESS_TTL_SEC=900
# Время жизни refresh-токена, секунды (30 дней).
REFRESH_TTL_SEC=2592000

# -- Образы --------------------------------------------------
# Подставляются пайплайном деплоя. Локально можно не задавать —
# тогда compose соберёт образы сам.
# WEB_IMAGE=ghcr.io/владелец/репозиторий-web:latest
# API_IMAGE=ghcr.io/владелец/репозиторий-api:latest

# Ник владельца сервиса. Права администратора у него всегда, снять их
# нельзя никому. Пусто — владельца нет.
OWNER_USERNAME=

# -- Кино ----------------------------------------------------
# Потолок на один фильм, в байтах. По умолчанию 4 ГБ — это примерно
# полтора часа в хорошем качестве.
#
# На расход памяти сервера это число не влияет никак: фильм пишется на
# диск потоком и отдаётся потоком, в память он не поднимается ни при
# загрузке, ни при просмотре. Ограничивает оно только место на диске,
# поэтому смотрите на свободное место, а не на оперативную память.
#
# Тот же предел стоит в nginx (client_max_body_size в location
# /api/film/). Если поднимаете здесь — поднимите и там, иначе загрузка
# будет обрываться раньше, чем дойдёт до приложения.
# FILM_MAX_BYTES=4294967296

# -- Телевидение ---------------------------------------------
# Узлы, куда Sky TV имеет право ходить за эфиром и телепрограммой,
# через запятую. Пусто — не пойдёт никуда, и подключить источник
# нельзя.
#
# Это не «дополнительная проверка», а условие: добавляя сюда узел, вы
# подтверждаете, что показ вещания с него обеспечен законно. Запись
# «example.com» разрешает и сам узел, и его поддомены — сети доставки
# обычно раскиданы по «edge1.example.com».
#
# Подключить источник к каналу:
#   bash scripts/tv-source.sh <канал> <адрес> "основание показа"
# Загрузить каналы из плейлиста:
#   bash scripts/tv-import.sh playlist.m3u8 "основание показа"
# TV_ALLOWED_HOSTS=

# -- Подкасты ------------------------------------------------
# Потолки на файл выпуска: звук и видео порознь, потому что это разные
# по весу вещи. По умолчанию 512 МБ на звук и 4 ГБ на видео.
#
# На расход памяти сервера эти числа не влияют: файл пишется на диск
# потоком и отдаётся потоком, кусками по запрошенному диапазону. Они
# ограничивают только место на диске.
#
# Тот же предел стоит в nginx (client_max_body_size в location
# /api/podcasts/). Поднимаете здесь — поднимите и там.
# PODCAST_AUDIO_MAX_BYTES=536870912
# PODCAST_VIDEO_MAX_BYTES=4294967296

# -- Пересказ выпусков ---------------------------------------
# Ключ языковой модели. Живёт только здесь, на сервере: пересказ
# считается сервером, в браузер уходит уже готовый текст. Клиенту ключ
# не отдаётся никогда, и назвать свою модель или свой адрес он не может.
#
# Пусто — пересказа нет, и экран об этом честно пишет. Всё остальное в
# подкастах работает без него.
#
# Проще всего не трогать это руками, а запустить:
#   bash scripts/set-ai-key.sh
# Он настраивает Sky AI целиком за один заход: спрашивает ключ, даёт
# выбрать модель цифрой и, если нужно, подключает расшифровку речи.
# Каждый ключ проверяется пробным обращением, и ничего не сохраняется,
# если он не подошёл.
# AI_API_KEY=
# AI_MODEL=claude-sonnet-4-5-20250929
# AI_BASE_URL=https://api.anthropic.com
#
# Сколько новых пересказов сервер согласен посчитать за час — на всех
# вместе. Готовый пересказ берётся из базы и в этот счёт не идёт.
# AI_SUMMARIES_PER_HOUR=200

# -- Sky AI --------------------------------------------------
# Тот же ключ AI_API_KEY выше обслуживает и Sky AI. Отдельного ключа
# для него не нужно: разговор с моделью идёт с сервера, и в браузер
# уходит только готовый ответ.
#
# Обычный чат бесплатен и Prime не требует. Ограничен он числом
# сообщений в сутки — чтобы один человек не израсходовал общий ресурс
# за вечер, а не чтобы заставить купить подписку.
# AI_CHAT_PER_DAY=60
# AI_CHAT_PER_DAY_PRIME=400

# Sky «Вместе»: сколько человек в одной сессии совместного просмотра.
# По умолчанию десять. Выше сотни сервер не поднимет в любом случае.
# TOGETHER_MAX_PARTICIPANTS=10
#
# Дневные пределы Prime-инструментов.
# AI_SUMMARY_PER_DAY=60
# AI_FILE_PER_DAY=30
# AI_IMAGE_PER_DAY=40
# AI_TRANSCRIBE_PER_DAY=20
#
# Сколько запросов к модели идёт одновременно на весь сервер.
# AI_MAX_INFLIGHT=4

# -- Расшифровка речи ----------------------------------------
# Языковая модель речь не расшифровывает — это отдельная работа и
# отдельный поставщик. Ожидается обычная ручка
# /v1/audio/transcriptions: её понимают и Whisper API, и то, что
# ставят у себя.
#
# Пусто — расшифровки нет, и сервер честно об этом отвечает.
# Подставлять правдоподобный текст вместо расшифровки нельзя: человек
# поверит, что это сказали в записи.
# STT_API_KEY=
# STT_MODEL=whisper-1
# STT_BASE_URL=https://api.openai.com
# STT_MAX_INFLIGHT=2
