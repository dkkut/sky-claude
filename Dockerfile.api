# ============================================================
#  API — HTTP-сервер (8080) и WebSocket-хаб (8081).
#  server.mjs импортирует signal.mjs, поэтому оба слушателя
#  поднимаются одним процессом.
# ============================================================
FROM node:22-alpine

WORKDIR /app

# У бэкенда свой манифест (server/package.json) — в образ идёт только ws,
# без three, leaflet и остальных браузерных зависимостей фронтенда.
COPY server/package.json server/package-lock.json .npmrc ./
RUN npm ci --omit=dev --no-audit --no-fund && npm cache clean --force

COPY server/  ./server/
COPY scripts/ ./scripts/
COPY public/shop/ ./catalog-site/
# Тексты документов (регламенты, согласия, KutRent Market и т.д.) —
# server/agreements.mjs читает их с диска по относительному ../docs от
# своего собственного файла (т.е. /app/docs при этом WORKDIR). Без
# этой строки каталога в образе не было вовсе: любой документ отдавал
# бы ENOENT в проде, даже будучи полностью готов и закоммичен — ровно
# то, что видел человек как «документы не загрузились».
COPY docs/    ./docs/
# Список известных игр общий для сервера, клиента и Windows-приложения: server/gameactivity.mjs читает его по ../electron/ от своего файла.
# Без этой строки API падал на старте (ENOENT) и контейнер оставался unhealthy.
COPY electron/known-games.json ./electron/known-games.json

# Каталоги для музыки и кино создаём в образе и отдаём пользователю
# node. Именованный том при первом монтировании наследует владельца из
# образа — иначе он появился бы принадлежащим root, а процесс работает
# не от root и писать в него не смог бы: загрузка отвечала бы отказом
# на ровном месте.
#
# Каталоги — для ВСЕХ хранилищ, а не только музыки и кино: у остальных
# (market, video, tickets, aifiles, skyvideo, books, ...) их в образе не
# было, и именованный том создавался принадлежащим root — писать в него
# процесс node не мог.
RUN mkdir -p /data/music /data/film /data/podcasts /data/skyvideo /data/books \
      /data/bloom /data/stories /data/gifts /data/ads /data/campaigns /data/skins \
      /data/evidence /data/market /data/video /data/tickets /data/aifiles /data/transfer \
    && chown -R node:node /data

# Работаем не от root: образ node уже содержит пользователя node.
USER node

ENV NODE_ENV=production
EXPOSE 8080 8081

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "require('http').get('http://127.0.0.1:'+(process.env.API_PORT||8080)+'/healthz',r=>process.exit(r.statusCode===200?0:1)).on('error',()=>process.exit(1))"

# Reaper процессов даёт сам Docker (init: true в compose):
# отдельный tini в образе не нужен, а SIGTERM server.mjs обрабатывает сам.
CMD ["node", "server/server.mjs"]
