# ============================================================
#  Sky — HTTP-редирект и основной HTTPS-хост.
#  Файл обрабатывается envsubst при старте контейнера:
#  ${DOMAIN} подставляется из переменной окружения.
#  Переменные nginx ($host, $request_uri и т.д.) не трогаются —
#  envsubst подставляет только то, что есть в окружении.
# ============================================================

# Апстримы бэкенда. Имена резолвятся внутренней сетью compose.
upstream sky_api {
    server api:8080;
    keepalive 32;
}
upstream sky_ws {
    server api:8081;
}

# WebSocket требует проброса Upgrade/Connection как есть.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# -- :80 — только ACME и редирект на HTTPS --------------------
server {
    listen      80;
    listen [::]:80;
    # www.${DOMAIN} указан на случай домена второго уровня; для
    # поддомена такое имя просто никогда не придёт и ни на что не влияет.
    server_name ${DOMAIN} www.${DOMAIN};

    # Проверка Let's Encrypt должна ходить по HTTP.
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type "text/plain";
    }

    # Локальный health для docker healthcheck — без редиректа.
    location = /healthz {
        access_log off;
        add_header Content-Type text/plain;
        return 200 'ok';
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# -- :443 — приложение ----------------------------------------
server {
    listen      443 ssl;
    listen [::]:443 ssl;
    http2       on;
    # www.${DOMAIN} указан на случай домена второго уровня; для
    # поддомена такое имя просто никогда не придёт и ни на что не влияет.
    server_name ${DOMAIN} www.${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;

    # Только TLS 1.2+; наборы шифров с прямой секретностью.
    ssl_protocols             TLSv1.2 TLSv1.3;
    ssl_ciphers               ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_cache         shared:SSL:10m;
    ssl_session_timeout       1d;
    ssl_session_tickets       off;

    include /etc/nginx/snippets/security-headers.conf;

    # Не больше 100 одновременных соединений с одного адреса.
    limit_conn conn_per_ip 100;

    root  /usr/share/nginx/html;
    index index.html;

    # -- Health ------------------------------------------------
    location = /healthz {
        access_log off;
        add_header Content-Type text/plain;
        return 200 'ok';
    }

    # -- Ключ беты: тот же лимит, что и у проверки кода ---------
    location = /api/beta/unlock {
        limit_req zone=req_code burst=10 nodelay;
        include /etc/nginx/snippets/proxy-common.conf;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
        proxy_pass http://sky_api;
    }

    # -- Отправка кода: самый жёсткий лимит ---------------------
    #  Каждый такой запрос — это SMS, то есть деньги и чужой телефон,
    #  звенящий по чьей-то чужой воле. Пять в минуту с адреса — потолок.
    location = /api/auth/phone/start {
        limit_req zone=req_auth burst=5 nodelay;
        include /etc/nginx/snippets/proxy-common.conf;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
        proxy_pass http://sky_api;
    }

    # -- Проверка кода: лимит против перебора -------------------
    #  Здесь запас больше: человек ошибается в цифрах, а перебор всё
    #  равно упирается в счётчик попыток на самом коде (5 и код сгорает).
    location ~ ^/api/auth/(phone/verify|two-factor/verify)$ {
        limit_req zone=req_code burst=10 nodelay;
        include /etc/nginx/snippets/proxy-common.conf;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
        proxy_pass http://sky_api;
    }

    # -- Остальная авторизация: обычный лимит -------------------
    #  refresh, session и logout вызываются при каждой загрузке
    #  страницы. Держать их на «пять в минуту» значило бы выкидывать
    #  человека из аккаунта за то, что он несколько раз обновил вкладку.
    location ^~ /api/auth/ {
        limit_req zone=req_general burst=60 nodelay;
        include /etc/nginx/snippets/proxy-common.conf;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
        proxy_pass http://sky_api;
    }

    # -- Остальной API -----------------------------------------
    location ^~ /api/ {
        limit_req zone=req_general burst=60 nodelay;
        include /etc/nginx/snippets/proxy-common.conf;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
        proxy_pass http://sky_api;
    }

    # -- WebSocket-хаб ------------------------------------------
    location ^~ /ws {
        # Потолок одновременных сокетов с одного адреса: соединение
        # живёт часами, и открыть их тысячами — готовый отказ в
        # обслуживании ещё до всякой авторизации. Запас на общий выход
        # в интернет у семьи или офиса; на человека потолок отдельный и
        # строже — он в самом хабе.
        limit_conn conn_ws 30;

        include /etc/nginx/snippets/proxy-common.conf;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        # Соединение живёт долго: таймаут чтения больше обычного,
        # плюс пинги от самого хаба.
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;

        proxy_pass http://sky_ws;
    }

    # -- Статика с хешем в имени — кэш навсегда ----------------
    location /assets/ {
        # Свой add_header отменяет унаследованные от server-блока,
        # поэтому заголовки безопасности подключаются здесь заново.
        include /etc/nginx/snippets/security-headers.conf;
        # expires сам выставляет Cache-Control, поэтому не используем его —
        # иначе заголовок уходит клиенту дважды.
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # -- SPA: всё остальное отдаём index.html ------------------
    location / {
        limit_req zone=req_general burst=60 nodelay;
        # Тот же случай: свой add_header — значит сниппет нужен повторно.
        include /etc/nginx/snippets/security-headers.conf;
        # index.html не кэшируем, иначе клиент застрянет на старой сборке.
        add_header Cache-Control "no-cache" always;
        try_files $uri $uri/ /index.html;
    }
}
