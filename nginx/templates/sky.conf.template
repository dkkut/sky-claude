# ============================================================
#  Sky — HTTP-редирект и основной HTTPS-хост.
#  Файл обрабатывается envsubst при старте контейнера:
#  ${DOMAIN} подставляется из переменной окружения.
#  Переменные nginx ($host, $request_uri и т.д.) не трогаются —
#  envsubst подставляет только то, что есть в окружении.
# ============================================================

# Апстримы бэкенда. Имена резолвятся внутренней сетью compose.
upstream sky_api {
    server api:8080;
    keepalive 32;
}
upstream sky_ws {
    server api:8081;
}

# WebSocket требует проброса Upgrade/Connection как есть.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# -- :80 — только ACME и редирект на HTTPS --------------------
server {
    # default_server — этот вхост первым появился и должен отвечать на
    # любой запрос без совпавшего Host (в т.ч. Docker healthcheck: он
    # бьёт по 127.0.0.1, а не по ${DOMAIN}). Без явного default_server
    # порядок между этим файлом и conf.d/market.conf решил бы алфавит
    # имён файлов — market.conf раньше sky.conf, и здоровье Sky
    # неожиданно проверялось бы редиректом чужого вхоста.
    listen      80 default_server;
    listen [::]:80 default_server;
    # www.${DOMAIN} указан на случай домена второго уровня; для
    # поддомена такое имя просто никогда не придёт и ни на что не влияет.
    server_name ${DOMAIN} www.${DOMAIN} ${RESERVE_DOMAIN};

    # Проверка Let's Encrypt должна ходить по HTTP.
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type "text/plain";
    }

    # Локальный health для docker healthcheck — без редиректа.
    location = /healthz {
        access_log off;
        add_header Content-Type text/plain;
        return 200 'ok';
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# -- :443 — приложение ----------------------------------------
server {
    listen      443 ssl default_server;
    listen [::]:443 ssl default_server;
    http2       on;
    # www.${DOMAIN} указан на случай домена второго уровня; для
    # поддомена такое имя просто никогда не придёт и ни на что не влияет.
    server_name ${DOMAIN} www.${DOMAIN} ${RESERVE_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;

    # ${RESERVE_DOMAIN} — резервный адрес API для приложений (VITE_API_FALLBACKS): тот же вхост и тот же сертификат (SAN),
    # см. scripts/add-reserve-domain.sh. Не задан — заглушка-домен, ни на что не влияет.

    # Только TLS 1.2+; наборы шифров с прямой секретностью.
    ssl_protocols             TLSv1.2 TLSv1.3;
    ssl_ciphers               ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_cache         shared:SSL:10m;
    ssl_session_timeout       1d;
    ssl_session_tickets       off;

    include /etc/nginx/snippets/security-headers.conf;

    # Не больше 100 одновременных соединений с одного адреса.
    limit_conn conn_per_ip 100;

    root  /usr/share/nginx/html;
    index index.html;

    # -- Health ------------------------------------------------
    location = /healthz {
        access_log off;
        add_header Content-Type text/plain;
        return 200 'ok';
    }

    # -- Ключ беты: тот же лимит, что и у проверки кода ---------
    location = /api/beta/unlock {
        limit_req zone=req_code burst=10 nodelay;
        include /etc/nginx/snippets/proxy-common.conf;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
        proxy_pass http://sky_api;
    }

    # -- Отправка кода: самый жёсткий лимит ---------------------
    #  Каждый такой запрос — это SMS, то есть деньги и чужой телефон,
    #  звенящий по чьей-то чужой воле. Пять в минуту с адреса — потолок.
    location = /api/auth/phone/start {
        limit_req zone=req_auth burst=5 nodelay;
        include /etc/nginx/snippets/proxy-common.conf;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
        proxy_pass http://sky_api;
    }

    # -- Проверка кода: лимит против перебора -------------------
    #  Здесь запас больше: человек ошибается в цифрах, а перебор всё
    #  равно упирается в счётчик попыток на самом коде (5 и код сгорает).
    location ~ ^/api/auth/(phone/verify|two-factor/verify)$ {
        limit_req zone=req_code burst=10 nodelay;
        include /etc/nginx/snippets/proxy-common.conf;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
        proxy_pass http://sky_api;
    }

    # -- Остальная авторизация: обычный лимит -------------------
    #  refresh, session и logout вызываются при каждой загрузке
    #  страницы. Держать их на «пять в минуту» значило бы выкидывать
    #  человека из аккаунта за то, что он несколько раз обновил вкладку.
    location ^~ /api/auth/ {
        limit_req zone=req_general burst=60 nodelay;
        include /etc/nginx/snippets/proxy-common.conf;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
        proxy_pass http://sky_api;
    }

    # -- Остальной API -----------------------------------------
    # -- Вложения: единственное место с большим телом ------------
    location ^~ /api/files {
        limit_req zone=req_general burst=30 nodelay;
        # Потолок с запасом над серверным (10 МБ): отказ должен давать
        # приложение с понятной ошибкой, а не nginx безымянной 413.
        client_max_body_size 12m;
        # Файл идёт одним куском — буферизация только съедала бы память.
        proxy_request_buffering off;
        include /etc/nginx/snippets/proxy-common.conf;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
        proxy_pass http://sky_api;
    }

    # -- Музыка: свои файлы и своя отдача ------------------------
    #  Общий потолок тела в 1 МБ резал загрузку трека ещё на nginx:
    #  до приложения запрос не доходил, и человек получал безымянную
    #  413 вместо понятного ответа. Потолок здесь с запасом над
    #  серверным (30 МБ), чтобы отказ по размеру давало приложение.
    location ^~ /api/music/ {
        limit_req zone=req_general burst=300 nodelay;
        client_max_body_size 32m;
        # Тело идёт потоком: буферизация означала бы держать весь трек
        # в памяти или во временном файле дважды.
        proxy_request_buffering off;
        include /etc/nginx/snippets/proxy-common.conf;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_pass http://sky_api;
    }

    # -- Sky Transfer: куски файла до 4 МБ ------------------------
    #  Общий потолок тела 1m резал бы куски по 1–4 МБ ещё на nginx.
    #  Размер куска проверяет приложение (256 КБ – 4 МБ).
    # Sky Launcher: загрузка файлов сборок владельцем (до 4 ГБ на файл) и раздача файлов игрокам — потоком, без буферизации.
    location ^~ /api/launcher/dev/builds/ {
        limit_req zone=req_general burst=300 nodelay;
        client_max_body_size 4096m;
        proxy_request_buffering off;
        include /etc/nginx/snippets/proxy-common.conf;
        proxy_read_timeout 4h;
        proxy_send_timeout 4h;
        proxy_pass http://sky_api;
    }
    location ^~ /api/launcher/blob/ {
        limit_req zone=req_general burst=300 nodelay;
        proxy_buffering off;
        include /etc/nginx/snippets/proxy-common.conf;
        proxy_read_timeout 4h;
        proxy_send_timeout 4h;
        proxy_pass http://sky_api;
    }
    location ^~ /api/launcher/dev/games/ {
        limit_req zone=req_general burst=100 nodelay;
        client_max_body_size 2m;
        include /etc/nginx/snippets/proxy-common.conf;
        proxy_pass http://sky_api;
    }

    location ^~ /api/transfer/ {
        limit_req zone=req_general burst=300 nodelay;
        client_max_body_size 5m;
        include /etc/nginx/snippets/proxy-common.conf;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
        proxy_pass http://sky_api;
    }

    # Кино. Отличий от музыки два, и оба из-за размера файла.
    #
    # Тело запроса — до четырёх гигабайт (FILM_MAX_BYTES на стороне
    # api): общий client_max_body_size в 1m обрезал бы загрузку фильма
    # ещё до того, как она дойдёт до приложения, и человек видел бы
    # непонятный отказ 413.
    #
    # Ответ не буферизуется — это уже задано в proxy-common.conf, и
    # повторять директиву здесь нельзя: nginx считает это ошибкой и не
    # запускается. Важно это именно для кино: с буферизацией nginx
    # попытался бы сложить весь фильм во временный файл, прежде чем
    # отдать первый кадр.
    location ^~ /api/film/ {
        limit_req zone=req_general burst=180 nodelay;
        client_max_body_size 4096m;
        proxy_request_buffering off;
        include /etc/nginx/snippets/proxy-common.conf;
        # Загрузка фильма на медленной связи идёт долго, и обрывать её
        # по таймауту нельзя.
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_pass http://sky_api;
    }

    # Подкасты. Устроены как кино и по тем же причинам: видеовыпуск
    # весит столько же, а звуковой — сотни мегабайт. Общий потолок тела
    # в 1m обрезал бы загрузку выпуска ещё до приложения, и человек
    # видел бы безымянную 413 вместо понятного ответа.
    #
    # Ответ не буферизуется — это задано в proxy-common.conf, и
    # повторять директиву здесь нельзя. Для подкастов это важно так же,
    # как для кино: с буферизацией nginx складывал бы весь выпуск во
    # временный файл, прежде чем отдать первую секунду звука.
    location ^~ /api/podcasts/ {
        limit_req zone=req_general burst=180 nodelay;
        client_max_body_size 4096m;
        proxy_request_buffering off;
        include /etc/nginx/snippets/proxy-common.conf;
        # Загрузка выпуска на медленной связи идёт долго, и обрывать её
        # по таймауту нельзя.
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_pass http://sky_api;
    }

    # Sky Video/Studio. Та же причина и тот же лимит, что у кино и
    # подкастов (routes/skyvideo.mjs: до 4 ГБ по умолчанию,
    # SKYVIDEO_MAX_BYTES) — этого блока не было вовсе, и загрузка ролика
    # шла через общий location /api/ с потолком 1m. При таком лимите
    # nginx обрывает соединение прямо посреди отправки тела, браузер не
    # получает вообще никакого ответа (ни 413, ни что-то осмысленное) и
    # XMLHttpRequest сообщает это как onerror — в клиенте это превращалось
    # в «Нет связи с сервером», хотя сервер тут ни при чём.
    location ^~ /api/skyvideo/ {
        limit_req zone=req_general burst=180 nodelay;
        client_max_body_size 4096m;
        proxy_request_buffering off;
        include /etc/nginx/snippets/proxy-common.conf;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_pass http://sky_api;
    }

    # Афиши мероприятий. Обложка — до 6 МБ (см. routes/tickets.mjs), и
    # общий потолок тела в 1m обрезал бы её ещё на nginx: организатор
    # видел бы безымянную 413 вместо понятного отказа приложения.
    location ^~ /api/tickets/ {
        limit_req zone=req_general burst=90 nodelay;
        client_max_body_size 12m;
        proxy_request_buffering off;
        include /etc/nginx/snippets/proxy-common.conf;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
        proxy_pass http://sky_api;
    }

    # Sky AI. Тело большое по двум причинам: документ на разбор и запись
    # на расшифровку (до 96 МБ, см. aitools.mjs). Потолок здесь с
    # запасом над серверным, чтобы отказ по размеру давало приложение.
    #
    # Ответ модели приходит не сразу: разбор длинного документа думает
    # минуты, а расшифровка часовой записи — дольше. Короткий
    # proxy_read_timeout обрывал бы такой запрос на полпути, и человек
    # видел бы «шлюз не отвечает» вместо ответа, за который уже
    # заплачено.
    location ^~ /api/ai/ {
        limit_req zone=req_general burst=60 nodelay;
        client_max_body_size 128m;
        proxy_request_buffering off;
        include /etc/nginx/snippets/proxy-common.conf;
        proxy_read_timeout 360s;
        proxy_send_timeout 360s;
        proxy_pass http://sky_api;
    }

    # Sky Ads: рекламный материал — до 64 МБ видео (MAX_VIDEO_BYTES,
    # см. routes/ads.mjs). Общий потолок тела в 1m обрезал бы загрузку
    # ещё на nginx, и рекламодатель видел бы безымянную 413 вместо
    # понятного отказа приложения.
    location ^~ /api/ads/ {
        limit_req zone=req_general burst=90 nodelay;
        client_max_body_size 64m;
        proxy_request_buffering off;
        include /etc/nginx/snippets/proxy-common.conf;
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
        proxy_pass http://sky_api;
    }

    # Видеообзоры складов и пунктов выдачи — до 512 МБ (MAX_VIDEO_BYTES в
    # videoreview.mjs). Без этого блока загрузка шла через общий /api/ с
    # потолком 1m: nginx обрывал её посреди тела, и продавец видел только
    # «Не удалось загрузить», а в очереди администрации записи не было.
    location ^~ /api/logistics/video/ {
        limit_req zone=req_general burst=90 nodelay;
        client_max_body_size 512m;
        proxy_request_buffering off;
        include /etc/nginx/snippets/proxy-common.conf;
        proxy_read_timeout 900s;
        proxy_send_timeout 900s;
        proxy_pass http://sky_api;
    }

    # Sky GO: документы исполнителей (до 8 МБ). Общий потолок 1m обрывал бы загрузку фото СТС/прав.
    # Sky GO «Жилье и отдых»: фото объявлений (до 4 МБ).
    location ^~ /api/go/stay/my/ {
        limit_req zone=req_general burst=30 nodelay;
        client_max_body_size 6m;
        include /etc/nginx/snippets/proxy-common.conf;
        proxy_pass http://sky_api;
    }

    # Sky Market «На месте»: фото объявлений (до 4 МБ).
    location ^~ /api/onsite/my/ {
        limit_req zone=req_general burst=30 nodelay;
        client_max_body_size 6m;
        include /etc/nginx/snippets/proxy-common.conf;
        proxy_pass http://sky_api;
    }

    # Sky GO: фото к проблеме доставки (до 3 МБ). Общий потолок 1m обрывал бы загрузку.
    location ^~ /api/go/work/problems/ {
        limit_req zone=req_general burst=30 nodelay;
        client_max_body_size 4m;
        include /etc/nginx/snippets/proxy-common.conf;
        proxy_pass http://sky_api;
    }

    # Админка сайта: загрузка файлов приложений (apk/exe/… до 600 МБ) потоком.
    location ^~ /api/admin/site/downloads/ {
        limit_req zone=req_general burst=20 nodelay;
        client_max_body_size 600m;
        proxy_request_buffering off;
        include /etc/nginx/snippets/proxy-common.conf;
        proxy_read_timeout 900s;
        proxy_send_timeout 900s;
        proxy_pass http://sky_api;
    }

    # Админка «Обновления»: файлы приложений для окна «Обновления» в настройках (до 600 МБ) потоком.
    location ^~ /api/admin/site/app-updates/ {
        limit_req zone=req_general burst=20 nodelay;
        client_max_body_size 600m;
        proxy_request_buffering off;
        include /etc/nginx/snippets/proxy-common.conf;
        proxy_read_timeout 900s;
        proxy_send_timeout 900s;
        proxy_pass http://sky_api;
    }

    location ^~ /api/go/executors/ {
        limit_req zone=req_general burst=30 nodelay;
        client_max_body_size 9m;
        include /etc/nginx/snippets/proxy-common.conf;
        proxy_pass http://sky_api;
    }

    location ^~ /api/ {
        limit_req zone=req_general burst=60 nodelay;
        include /etc/nginx/snippets/proxy-common.conf;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
        proxy_pass http://sky_api;
    }

    # -- WebSocket-хаб ------------------------------------------
    location ^~ /ws {
        # Потолок одновременных сокетов с одного адреса: соединение
        # живёт часами, и открыть их тысячами — готовый отказ в
        # обслуживании ещё до всякой авторизации. Запас на общий выход
        # в интернет у семьи или офиса; на человека потолок отдельный и
        # строже — он в самом хабе.
        limit_conn conn_ws 30;

        include /etc/nginx/snippets/proxy-common.conf;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        # Соединение живёт долго: таймаут чтения больше обычного,
        # плюс пинги от самого хаба.
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;

        proxy_pass http://sky_ws;
    }

    # -- Статика с хешем в имени — кэш навсегда ----------------
    location /assets/ {
        # Свой add_header отменяет унаследованные от server-блока,
        # поэтому заголовки безопасности подключаются здесь заново.
        include /etc/nginx/snippets/security-headers.conf;
        # expires сам выставляет Cache-Control, поэтому не используем его —
        # иначе заголовок уходит клиенту дважды.
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # Служебные файлы, карты сборки и резервные остатки наружу не отдаём. API (`^~ /api/`) и /.well-known/ (ACME) этих правил не касаются.
    location ~ "^/\.(?!well-known/)" { return 404; }
    location ~* "\.(map|env|bak|old|orig|swp|sql|pem|key)$" { return 404; }

    # -- Ссылки из писем: отдельная страница, не приложение ----
    #  Вход в панель администратора, вход по SSH, разморозка аккаунта. verify.html не грузит приложение Sky,
    #  поэтому ссылка открывает именно подтверждение, а не главную сайта (заставка, бета, техработы, старый кэш).
    location ~ ^/(admin-verify|ssh-verify|ssh-confirm|2fa-reset|unfreeze|storage-verify|defense-undo)$ {
        limit_req zone=req_general burst=30 nodelay;
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-store" always;
        try_files /verify.html =404;
    }

    # -- Страница оплаты SkyKassa Business (/p/<id>): открывается без входа в Sky, приложение не грузится ----
    location ~ "^/p/[a-z0-9]{12,24}/?$" {
        limit_req zone=req_general burst=30 nodelay;
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-store" always;
        try_files /pay.html =404;
    }

    # -- Витрина SkyKassa Business: /s/<адрес> (тот же сайт каталога, что ставится на VPS бизнеса; файлы лежат в /shop/) --
    location ~ ^/s/[a-z0-9-]+$ { return 301 $uri/; }
    location ~ ^/s/[a-z0-9-]+/$ {
        limit_req zone=req_general burst=30 nodelay;
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-store" always;
        try_files /shop/index.html =404;
    }
    location ~ ^/s/[a-z0-9-]+/(app\.js|style\.css|config\.js)$ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files /shop/$1 =404;
    }

    # -- SPA: всё остальное отдаём index.html ------------------
    location / {
        limit_req zone=req_general burst=60 nodelay;
        # Тот же случай: свой add_header — значит сниппет нужен повторно.
        include /etc/nginx/snippets/security-headers.conf;
        # index.html не кэшируем, иначе клиент застрянет на старой сборке.
        add_header Cache-Control "no-cache" always;
        try_files $uri $uri/ /index.html;
    }
}
