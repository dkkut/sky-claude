# dependencies
node_modules/

# build output
dist/
dist-ssr/
*.local

# secrets — НИКОГДА не коммитить
.env
.env.*
!.env.example
# .env.native — не секрет, а флаги нативной сборки (Android/Windows),
# подхватываемые Vite-режимом "native"; коммитится нарочно.
!.env.native

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# editors / OS
.DS_Store
Thumbs.db
*.swp

# caches
.vite/
.eslintcache
coverage/

# локальные варианты образов для отладки сборки
Dockerfile*.test
ca-bundle.crt
dump.rdb

# Android (Capacitor) — сборочные каталоги и локальные пути SDK
android/app/build/
android/build/
android/.gradle/
android/capacitor-cordova-android-plugins/build/
android/local.properties
*.apk
*.aab

# Electron — сборочный вывод, не исходники
release/
*.exe
*.dmg
*.AppImage

# Ключи подписи — никогда не коммитить
*.keystore
*.jks

# Сигнал аварийного выключения (server/breach.mjs) — создаётся на
# сервере docker-compose-биндом, в репозитории ему делать нечего.
/control/
