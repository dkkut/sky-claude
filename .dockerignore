# Зависимости и артефакты — ставятся/собираются внутри образа.
node_modules
dist
dist-ssr

# Секреты не должны попадать в контекст сборки.
.env
.env.*
!.env.example

# История и служебное.
.git
.gitignore
.github
.vscode
*.log
npm-debug.log*

# Документация и windows-скрипты в образе не нужны — кроме документов,
# которые приложение показывает во вкладке «Информация». Они лежат в
# docs/ единственным экземпляром, и сборка берёт их оттуда.
# Внутренние заметки (замечания, опись данных, ход работы) в образ не
# попадают: они для нас, а не для пользователя.
docs
*.md
!README.md
!docs/ПРАВИЛА.md
!docs/ПРАВИЛА_ПРОДАВЦОВ.md
!docs/ОФЕРТА.md
!docs/УСЛУГИ_И_СТОИМОСТЬ.md
!docs/СОГЛАСИЕ_НА_ОБРАБОТКУ_ПД.md
!docs/ПОЛИТИКА_КОНФИДЕНЦИАЛЬНОСТИ.md
!docs/КОНТАКТЫ.md
# Эти три не попадали в белый список, хотя server/agreements.mjs их
# читает — склад и KutRent Market отдавали ENOENT на каждый запрос
# документа в проде, а не только что-то не показывалось: readDocument
# бросало исключение на отсутствующий файл.
!docs/РЕГЛАМЕНТ_ОБЩЕГО_СКЛАДА.md
!docs/KUTRENT_ПОЛЬЗОВАТЕЛЬСКОЕ_СОГЛАШЕНИЕ.md
!docs/KUTRENT_ПОЛИТИКА_КОНФИДЕНЦИАЛЬНОСТИ.md
START.bat
START.ps1
scripts/run-windows.*
scripts/dev-*.mjs
