# Флаги нативной сборки (Android/Windows) — подхватываются автоматически
# режимом Vite "native" (npm run build:native = vite build --mode native).
# Секретов здесь нет, файл коммитится.
#
# В обычной веб-сборке (vite build, деплой на сайт) этот файл не
# читается вовсе — поведение остаётся прежним: относительные пути,
# HttpOnly-кука. См. src/core/nativeApp.ts.
VITE_NATIVE_APP=1
VITE_API_ORIGIN=https://web.skymessenger.online
# Запасные адреса API через запятую (только https, тот же сервер под другим доменом). Пусто — без переключения.
# Приложение само перейдёт на первый живой, если основной не отвечает, и вернётся, когда он оживёт.
VITE_API_FALLBACKS=https://reserve.skymessenger.online
