{
  "name": "sky-bloom",
  "version": "5.0.0-beta",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "dev:local": "vite --host",
    "dev:win": "vite --host",
    "healthcheck": "node scripts/healthcheck.mjs",
    "start:api": "node server/server.mjs",
    "healthcheck:api": "HEALTHCHECK_URL=http://127.0.0.1:8080/healthz node scripts/healthcheck.mjs",
    "electron:dev": "electron .",
    "electron:build:win": "electron-builder --win nsis",
    "electron:build:linux": "electron-builder --linux AppImage",
    "cap:sync": "npm run build:native && npx cap sync android",
    "cap:sync:ios": "npm run build:native && npx cap sync ios",
    "build:native": "vite build --mode native",
    "push:keys": "node scripts/gen-vapid.mjs",
    "i18n:check": "node scripts/i18n-check.mjs"
  },
  "dependencies": {
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/push-notifications": "^8.1.3",
    "capacitor-music-controls-plugin": "^8.0.0",
    "framer-motion": "^11.0.8",
    "hls.js": "^1.7.3",
    "jsqr": "^1.4.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.469.0",
    "music-metadata": "^12.2.2",
    "qrcode-generator": "^2.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "three": "^0.160.0",
    "ws": "^8.18.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@eslint/js": "^9.17.0",
    "@types/leaflet": "^1.9.8",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.160.0",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.18.1",
    "vite": "^6.0.5"
  },
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "build": {
    "appId": "online.skymessenger.desktop",
    "productName": "Sky",
    "files": [
      "electron/**/*",
      "dist/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "build-resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "target": "AppImage",
      "icon": "build-resources/icon.png",
      "category": "Network"
    }
  }
}
